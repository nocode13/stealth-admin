# Base URL of stealth-backend (admin API). No global prefix; cookie session auth.
VITE_API_BASE_URL=http://localhost:3000

# Public links to a listing (the "Артикул" column copies them). Optional — prod defaults
# live in src/shared/config/env.ts. Mini App URL is t.me/<bot>/<short_name> (BotFather → /myapps).
VITE_WEB_APP_URL=
VITE_TELEGRAM_MINI_APP_URL=
